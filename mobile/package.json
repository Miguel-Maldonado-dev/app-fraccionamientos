  "main": "expo-router/entry",
  "dependencies": {
    "@expo-google-fonts/inter": "0.4.2",
    "@expo-google-fonts/sora": "0.4.2",
    "@supabase/supabase-js": "2.119.0",
    "expo": "58.0.25",
    "expo-application": "58.1.2",
    "expo-constants": "58.0.16",
    "expo-crypto": "58.0.8",
    "expo-device": "58.0.5",
    "expo-file-system": "58.0.13",
    "expo-font": "58.0.12",
    "expo-haptics": "58.0.8",
    "expo-linear-gradient": "58.0.4",
    "expo-linking": "58.0.17",
    "expo-router": "58.0.31",
    "expo-secure-store": "58.0.3",
    "expo-sharing": "58.0.23",
    "expo-status-bar": "58.0.5",
    "lucide-react-native": "1.72.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "5.11.1",
    "react-native-screens": "4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-url-polyfill": "4.0.0"
  },
  "devDependencies": {
    "@testing-library/react-native": "14.1.0",
    "@types/jest": "30.0.0",
    "@types/react": "19.3.0",
    "jest": "30.5.2",
    "jest-expo": "58.0.14",
    "test-renderer": "1.3.1",
    "typescript": "6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "test": "jest",
    "typecheck": "tsc --noEmit"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "setupFiles": [
      "./jest.setup.ts"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@supabase/.*|lucide-react-native|react-native-svg)"
    ],
    "moduleNameMapper": {
      "^lucide-react-native$": "<rootDir>/node_modules/lucide-react-native/dist/cjs/lucide-react-native.js"
    }
  }
}
